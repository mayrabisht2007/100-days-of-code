//Q93: Check if two strings are anagrams of each other.

/*
Sample Test Cases:
Input 1:
listen
silent
Output 1:
Anagrams

Input 2:
hello
world
Output 2:
Not anagrams

*/
#include <stdio.h>
#include <string.h>

int main() {
    char s1, s2;
    printf("Enter string 1 and string 2: ");
    scanf("%s %s", s1, s2);

    int l1 = strlen(s1);
    int l2 = strlen(s2);

    if (l1 != l2) {
        printf("Not anagrams");
        return 0;
    }

    int c = 0;
    char ch;

    for (int i = 0; i < l1; i++) {
        ch = s1[i];

        for (int j = 0; j < l2; j++) {
            if (ch == s2[j]) {
                c++;
                s2[j] = '*';
                break;
            }
        }
    }

    if (c != l1) {
        printf("Not anagrams");
    } else {
        printf("Anagrams");
    }

    return 0;
}
