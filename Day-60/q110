//Q110: Write a program to take an integer array arr and an integer k as inputs. The task is to find the maximum element in each subarray of size k moving from left to right. Print the maximum elements for each window separated by spaces as output.

/*
Sample Test Cases:
Input 1:
arr[1, 2, 3, 1, 4, 5, 2, 3, 6] = , k = 3
Output 1:
3 3 4 5 5 5 6

Input 2:
arr[5, 1, 3, 4, 2] = , k = 1
Output 2:
5 1 3 4 2

*/
#include <stdio.h>

#define MAX_SIZE 1000

void printKMax(int arr[], int n, int k) {
    if (k <= 0 || k > n) {
        return;
    }

    int deque[MAX_SIZE];
    int front = 0, rear = -1;

    // Process the first window of k elements
    for (int i = 0; i < k; i++) {
        while (front <= rear && arr[i] >= arr[deque[rear]]) {
            rear--;
        }
        deque[++rear] = i;
    }

    // Slide the window from index k to n - 1
    for (int i = k; i < n; i++) {
        printf("%d ", arr[deque[front]]);

        // Remove indices that are outside the current window
        while (front <= rear && deque[front] <= i - k) {
            front++;
        }

        // Remove indices whose elements are smaller than arr[i]
        while (front <= rear && arr[i] >= arr[deque[rear]]) {
            rear--;
        }

        deque[++rear] = i;
    }

    // Print the maximum of the final window
    printf("%d\n", arr[deque[front]]);
}

int main() {
    int n, k;
    int arr[MAX_SIZE];

    printf("Enter the number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0 || n > MAX_SIZE) {
        return 1;
    }

    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter window size k: ");
    scanf("%d", &k);

    printKMax(arr, n, k);

    return 0;
}
