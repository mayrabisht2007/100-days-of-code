//Q124: Take two filenames from the user – a source file and a destination file. Copy all the content from the source file to the destination file using fgetc() and fputc().

/*
Sample Test Cases:
Input 1:
Source File: source.txt (Content: Learning C File Handling)
Output 1:
File copied successfully to destination.txt

*/
#include <stdio.h>

int main() {
    FILE *source, *destination;
    char sourceName[100], destName[100];
    int ch;

    // Take filenames from the user
    printf("Enter source filename: ");
    scanf("%99s", sourceName);

    printf("Enter destination filename: ");
    scanf("%99s", destName);

    // Open the source file in read mode
    source = fopen(sourceName, "r");
    if (source == NULL) {
        printf("Error: Could not open source file %s\n", sourceName);
        return 1;
    }

    // Open the destination file in write mode
    destination = fopen(destName, "w");
    if (destination == NULL) {
        printf("Error: Could not open destination file %s\n", destName);
        fclose(source);
        return 1;
    }

    // Copy content character by character until EOF
    while ((ch = fgetc(source)) != EOF) {
        fputc(ch, destination);
    }

    // Close both files
    fclose(source);
    fclose(destination);

    printf("File copied successfully to %s\n", destName);

    return 0;
}
