//Q136: Use enum to represent menu choices (ADD, SUBTRACT, MULTIPLY) and perform operations using switch.

/*
Sample Test Cases:
Input 1:
ADD 10 20
Output 1:
30

*/
#include <stdio.h>
#include <string.h>

enum Operation {
    ADD,
    SUBTRACT,
    MULTIPLY,
    INVALID
};

int main() {
    char input[20];
    int num1, num2;
    enum Operation choice;

    // Read operation string and two integers
    if (scanf("%s %d %d", input, &num1, &num2) != 3) {
        return 1;
    }

    // Map string input to enum constant
    if (strcmp(input, "ADD") == 0) {
        choice = ADD;
    } else if (strcmp(input, "SUBTRACT") == 0) {
        choice = SUBTRACT;
    } else if (strcmp(input, "MULTIPLY") == 0) {
        choice = MULTIPLY;
    } else {
        choice = INVALID;
    }

    // Perform operation using switch
    switch (choice) {
        case ADD:
            printf("%d\n", num1 + num2);
            break;
        case SUBTRACT:
            printf("%d\n", num1 - num2);
            break;
        case MULTIPLY:
            printf("%d\n", num1 * num2);
            break;
        default:
            printf("Invalid operation\n");
            break;
    }

    return 0;
}
