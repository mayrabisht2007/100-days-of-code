//Q100: Print all sub-strings of a string.

/*
Sample Test Cases:
Input 1:
abc
Output 1:
a,ab,abc,b,bc,c

*/
#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    
    // Read input string
    scanf("%s", str);
    
    int n = strlen(str);
    
    // Outer loop picks the starting index
    for (int i = 0; i < n; i++) {
        // Middle loop picks the ending index
        for (int j = i; j < n; j++) {
            // Inner loop prints characters from start (i) to end (j)
            for (int k = i; k <= j; k++) {
                printf("%c", str[k]);
            }
            
            // Print a comma after every substring except the very last one
            if (!(i == n - 1 && j == n - 1)) {
                printf(",");
            }
        }
    }
    
    printf("\n");
    return 0;
}
