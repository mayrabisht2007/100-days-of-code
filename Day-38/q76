//Q76: Check if a matrix is symmetric.

/*
Sample Test Cases:
Input 1:
2 2
1 2
2 1
Output 1:
True

Input 2:
2 2
1 0
2 1
Output 2:
False

*/
#include <stdio.h>

int main() {
    int r, c, i, j;
    int a;
    int flag = 1;

    // Read rows and columns
    scanf("%d %d", &r, &c);

    // Read the matrix elements
    for (i = 0; i < r; i++) {
        for (j = 0; j < c; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // A symmetric matrix must have equal rows and columns
    if (r != c) {
        printf("Not Symmetric\n");
        return 0;
    }

    // Compare each element with its mirrored position
    for (i = 0; i < r; i++) {
        for (j = 0; j < c; j++) {
            if (a[i][j] != a[j][i]) {
                flag = 0;
                break;
            }
        }
    }

    // Print the final result
    if (flag == 1) {
        printf("Symmetric\n");
    } else {
        printf("Not Symmetric\n");
    }

    return 0;
}
