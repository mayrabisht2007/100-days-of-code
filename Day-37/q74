//Q74: Find the transpose of a matrix.

/*
Sample Test Cases:
Input 1:
2 3
1 2 3
4 5 6
Output 1:
1 4
2 5
3 6

*/
#include <stdio.h>

int main() {
    int r, c;
    
    // Read rows and columns
    if (scanf("%d %d", &r, &c) != 2) return 0;

    int matrix[r][c];
    int transpose[c][r]; // Notice dimensions are flipped (c x r)

    // Input original matrix
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Compute transpose by swapping row and column indices
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            transpose[j][i] = matrix[i][j];
        }
    }

    // Print the transposed matrix (c rows, r columns)
    for (int i = 0; i < c; i++) {
        for (int j = 0; j < r; j++) {
            printf("%d%s", transpose[i][j], (j == r - 1) ? "" : " ");
        }
        printf("\n");
    }

    return 0;
}
