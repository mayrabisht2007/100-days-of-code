//Q73: Find the sum of each row of a matrix and store it in an array.

/*
Sample Test Cases:
Input 1:
2 3
1 2 3
4 5 6
Output 1:
6 15

*/
#include <stdio.h>

int main() {
    int r, c;
    scanf("%d %d", &r, &c);

    int matrix[r][c];
    
    // Input matrix
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // 1. Take another array of size equal to the number of rows
    int rowSum[r];
    int sum = 0;

    // 2. Run the loop to calculate and store each row's sum
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            sum = sum + matrix[i][j];
        }
        
        // Store the sum in the new array
        rowSum[i] = sum;
        
        // 3. Reset sum back to 0 for the next row
        sum = 0; 
    }

    // Print the result array
    for (int i = 0; i < r; i++) {
        printf("%d ", rowSum[i]);
    }

    return 0;
}
