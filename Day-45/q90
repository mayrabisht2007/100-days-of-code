//Q90: Toggle case of each character in a string.

/*
Sample Test Cases:
Input 1:
Hello
Output 1:
hELLO

*/
#include <stdio.h>

int main() {
    char str[1000];
    
    // Read input string (use fgets to also support spaces if needed)
    if (fgets(str, sizeof(str), stdin) != NULL) {
        int i = 0;
        
        // Traverse each character until the null terminator
        while (str[i] != '\0') {
            if (str[i] >= 'A' && str[i] <= 'Z') {
                // Convert uppercase to lowercase
                str[i] = str[i] + 32;
            } else if (str[i] >= 'a' && str[i] <= 'z') {
                // Convert lowercase to uppercase
                str[i] = str[i] - 32;
            }
            i++;
        }
        
        // Print the toggled string
        printf("%s", str);
    }
    
    return 0;
}
