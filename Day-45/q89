//Q89: Count frequency of a given character in a string.

/*
Sample Test Cases:
Input 1:
programming
g
Output 1:
2

*/
#include <stdio.h>

int main() {
    char str[100], ch;
    int count = 0;

    // Read the string and the character to search
    scanf("%s %c", str, &ch);

    // Loop through the string until the null terminator
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] == ch) {
            count++;
        }
    }

    // Print the final count
    printf("%d\n", count);

    return 0;
}
