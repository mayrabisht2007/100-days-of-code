//Q72: Find the sum of all elements in a matrix.

/*
Sample Test Cases:
Input 1:
2 3
1 2 3
4 5 6
Output 1:
21

*/
#include <stdio.h>

int main() {
    int rows, cols;
    
    // Read number of rows and columns
    if (scanf("%d %d", &rows, &cols) != 2) return 1;
    
    int matrix[rows][cols];
    long long sum = 0; // Use long long to prevent integer overflow
    
    // Read elements and compute sum simultaneously
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            scanf("%d", &matrix[i][j]);
            sum += matrix[i][j];
        }
    }
    
    printf("%lld\n", sum);
    
    return 0;
}
